diff --git a/Online/Menus/SpireCpu/ConfigureDebugVs.asm b/Online/Menus/SpireCpu/ConfigureDebugVs.asm
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/Online/Menus/SpireCpu/ConfigureDebugVs.asm
@@ -0,0 +1,53 @@
+#To be inserted at 801b1428
+.include "../../../Common/Common.s"
+
+# r28 is StartMeleeData after Melee initialized all rule/player defaults.
+# Read the eight-byte Spire contract from Dolphin.
+li r3, 8
+branchl r12, HSD_MemAlloc
+mr r27, r3
+li r3, CONST_SlippiCmdGetSpireDuel
+stb r3, 0(r27)
+mr r3, r27
+li r4, 1
+li r5, CONST_ExiWrite
+branchl r12, FN_EXITransferBuffer
+mr r3, r27
+li r4, 8
+li r5, CONST_ExiRead
+branchl r12, FN_EXITransferBuffer
+
+# Stock rules, selected legal stage, one-stock human P1 versus level-5 CPU P2.
+lbz r3, 0(r28)
+rlwinm r3, r3, 0, 27, 31
+ori r3, r3, 0x20
+stb r3, 0(r28)
+lbz r3, 2(r28)
+ori r3, r3, 0x80
+stb r3, 2(r28)
+lhz r3, 4(r27)
+sth r3, 0x0E(r28)
+
+lbz r3, 2(r27)
+stb r3, 0x60(r28)
+li r3, 0
+stb r3, 0x61(r28)
+lbz r3, 6(r27)
+stb r3, 0x62(r28)
+
+lbz r3, 3(r27)
+stb r3, 0x84(r28)
+li r3, 1
+stb r3, 0x85(r28)
+lbz r3, 6(r27)
+stb r3, 0x86(r28)
+lbz r3, 7(r27)
+stb r3, 0x93(r28)
+
+li r3, 3
+stb r3, 0xA9(r28)
+stb r3, 0xCD(r28)
+
+mr r3, r27
+branchl r12, HSD_Free
+branch r12, 0x801b1488
