@@ -119,6 +119,25 @@ cmpwi r3, 0
 bne SKIP_START_MATCH # skip input if chat window is opened
 
 # When idle, pressing start will start finding match
+# A Spire Showdown launch searches immediately. Its bridge supplied every
+# selection, and the StS loading animation still covers this CSS.
+bl FN_IS_SPIRE_DUEL
+cmpwi r3, 0
+beq HANDLE_IDLE_CHECK_START
+
+loadGlobalFrame r3
+cmpwi r3, 0
+beq SKIP_START_MATCH
+
+li r3, ISWINNER_NULL
+stb r3, OFST_R13_ISWINNER(r13)
+li r3, 0
+stb r3, OFST_R13_CHOSESTAGE(r13)
+li r3, SB_NOTSEL
+bl FN_LOCK_IN_AND_SEARCH
+b SKIP_START_MATCH
+
+HANDLE_IDLE_CHECK_START:
 # Check if start was pressed
 rlwinm.	r0, REG_INPUTS, 0, 19, 19
 beq SKIP_START_MATCH # Exit if start was not pressed
@@ -560,6 +579,37 @@ branchl r12, HSD_Free
 restore
 blr
 
+################################################################################
+# Function: Check whether Dolphin loaded a Spire Showdown duel contract
+# Returns r3 = 1 when active, otherwise 0.
+################################################################################
+FN_IS_SPIRE_DUEL:
+backup
+
+li r3, 8
+branchl r12, HSD_MemAlloc
+mr r20, r3
+li r3, CONST_SlippiCmdGetSpireDuel
+stb r3, 0(r20)
+
+mr r3, r20
+li r4, 8
+li r5, CONST_ExiWrite
+branchl r12, FN_EXITransferBuffer
+
+mr r3, r20
+li r4, 1
+li r5, CONST_ExiRead
+branchl r12, FN_EXITransferBuffer
+lbz r21, 0(r20)
+
+mr r3, r20
+branchl r12, HSD_Free
+mr r3, r21
+
+restore
+blr
+
 
 ################################################################################
 # Skip starting match
