+void CEXISlippi::prepareSpireDuelStatus()
+{
+	m_read_queue.clear();
+	m_read_queue.push_back(spireDuel.enabled ? 1 : 0);
+	m_read_queue.push_back(spireDuel.cpuTest ? 1 : 0);
+	m_read_queue.push_back(spireDuel.localCharacter);
+	m_read_queue.push_back(spireDuel.remoteCharacter);
+	m_read_queue.push_back(static_cast<u8>(spireDuel.stage >> 8));
+	m_read_queue.push_back(static_cast<u8>(spireDuel.stage));
+	m_read_queue.push_back(spireDuel.stocks);
+	m_read_queue.push_back(spireDuel.cpuLevel);
+}
