+void CEXISlippi::loadSpireDuelSettings()
+{
+	const auto &path = SConfig::GetInstance().m_spireDuelFile;
+	if (path.empty())
+		return;
+
+	std::string contents;
+	if (!File::ReadFileToString(path, contents))
+	{
+		forcedError = "Spire Showdown could not read its duel file";
+		ERROR_LOG(SLIPPI_ONLINE, "%s: %s", forcedError.c_str(), path.c_str());
+		return;
+	}
+
+	auto config = json::parse(contents, nullptr, false);
+	if (config.is_discarded() || !config.is_object())
+	{
+		forcedError = "Spire Showdown received invalid duel JSON";
+		ERROR_LOG(SLIPPI_ONLINE, "%s", forcedError.c_str());
+		return;
+	}
+
+	try
+	{
+		spireDuel.duelId = config.at("duel_id").get<std::string>();
+		spireDuel.opponentConnectCode = config.at("opponent_connect_code").get<std::string>();
+		spireDuel.localCharacter = config.at("local_character").get<u8>();
+		spireDuel.remoteCharacter = config.at("remote_character").get<u8>();
+		spireDuel.stage = config.at("stage").get<u16>();
+		spireDuel.stocks = config.at("stocks").get<u8>();
+	}
+	catch (const std::exception &error)
+	{
+		forcedError = "Spire Showdown duel JSON is missing required fields";
+		ERROR_LOG(SLIPPI_ONLINE, "%s: %s", forcedError.c_str(), error.what());
+		return;
+	}
+
+	const bool safeId = !spireDuel.duelId.empty() && spireDuel.duelId.size() <= 64 &&
+	                    std::all_of(spireDuel.duelId.begin(), spireDuel.duelId.end(), [](char value) {
+		                    const auto byte = static_cast<unsigned char>(value);
+		                    return std::isalnum(byte) || value == '-' || value == '_';
+	                    });
+	const bool validCode = !spireDuel.opponentConnectCode.empty() && spireDuel.opponentConnectCode.size() <= 9 &&
+	                       spireDuel.opponentConnectCode.find('#') != std::string::npos;
+	const bool legalStage = std::find(allowedStages.begin(), allowedStages.end(), spireDuel.stage) != allowedStages.end();
+	if (!safeId || !validCode || spireDuel.localCharacter >= 26 || spireDuel.remoteCharacter >= 26 ||
+	    !legalStage || spireDuel.stocks != 1)
+	{
+		forcedError = "Spire Showdown duel settings failed validation";
+		ERROR_LOG(SLIPPI_ONLINE, "%s", forcedError.c_str());
+		return;
+	}
+
+	spireDuel.enabled = true;
+	spireDuel.statusPath = path + ".status.json";
+	reportSpireDuelStatus("booting");
+	NOTICE_LOG(SLIPPI_ONLINE, "Loaded Spire Showdown duel %s", spireDuel.duelId.c_str());
+}
+
+void CEXISlippi::reportSpireDuelStatus(const std::string &phase, int winnerIdx)
+{
+	if (!spireDuel.enabled || spireDuel.statusPath.empty())
+		return;
+
+	const auto winner = winnerIdx < 0 ? "null" : std::to_string(winnerIdx);
+	const auto localWon = winnerIdx < 0 ? "null" : (winnerIdx == localPlayerIndex ? "true" : "false");
+	const auto status = StringFromFormat(
+	    "{\"duel_id\":\"%s\",\"phase\":\"%s\",\"winner_idx\":%s,\"local_won\":%s}\n",
+	    spireDuel.duelId.c_str(), phase.c_str(), winner.c_str(), localWon);
+	if (!File::WriteStringToFile(status, spireDuel.statusPath))
+		ERROR_LOG(SLIPPI_ONLINE, "Could not write Spire Showdown status: %s", spireDuel.statusPath.c_str());
+}
